# Copy to `.env.local` only if you need to override local defaults.
# NEVER put production credentials or service account keys in this repository.

NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-conta-comigo
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-conta-comigo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demolocal
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Indexação pelos buscadores: opt-in explícito, e sem efeito fora de produção.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ─── Pagamentos (opcional) ─────────────────────────────────────────────────────
# Sem nenhuma chave, o checkout fica desabilitado e as rotas de pagamento
# respondem 503. Todo o resto do produto funciona normalmente — e é assim que
# uma máquina de desenvolvimento deve ficar.
#
# NUNCA use o prefixo NEXT_PUBLIC_ aqui: exporia a chave no bundle.
# ASAAS_API_KEY=
# ASAAS_API_BASE_URL=https://api-sandbox.asaas.com/v3

# Obrigatório para receber webhooks. Sem ele o endpoint recusa todas as
# requisições, em vez de pular a verificação.
# PAYMENT_WEBHOOK_SECRET=

# ─── Preços ────────────────────────────────────────────────────────────────────
# Centavos inteiros, para não haver dúvida sobre separador decimal.
# Um ciclo sem preço válido simplesmente não é oferecido; sem nenhum dos dois, a
# tela de planos informa que a assinatura ainda não está disponível.
SUBSCRIPTION_PRICE_MONTHLY_CENTS=799
SUBSCRIPTION_PRICE_YEARLY_CENTS=6999

# ─── Consultoria com IA e leitura de comprovante (opcional) ────────────────────
# Sem a chave, a consultoria responde pelo motor determinístico local: o produto
# continua funcionando, sem custo por token. Com a chave, a rota passa a chamar o
# modelo — e é por isso que ela é autenticada e limitada por usuário.
#
# A mesma chave habilita a leitura de comprovante por foto (/api/ai/comprovante).
# Essa não tem motor local: sem a chave, a tela oferece a digitação normal. A
# foto não é armazenada em lugar nenhum — vai na requisição e some com ela.
#
# NUNCA use o prefixo NEXT_PUBLIC_ aqui: exporia a chave no bundle.
# GEMINI_API_KEY=
#
# Opcional. Trocar de modelo não deve exigir mudar código.
# GEMINI_MODEL=gemini-2.5-flash
