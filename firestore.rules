rules_version = '2';

// Conta comigo - Firestore Security Rules
//
// These rules are production code and are covered by tests in tests/rules.
// No feature is considered done until its rule has a test (docs/SECURITY.md).
//
// Three principles:
//   1. Default deny. Nothing is readable or writable unless a rule below says so.
//   2. The household is the only tenant boundary. Access to any financial
//      document requires an ACTIVE membership document in that household.
//   3. A document can never claim to belong to a household other than the one
//      it is stored under, and can never be moved between households.

service cloud.firestore {
  match /databases/{database}/documents {

    /* ------------------------------------------------------------ */
    /* Helpers                                                       */
    /* ------------------------------------------------------------ */

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function memberPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId)/members/$(request.auth.uid);
    }

    function householdPath(householdId) {
      return /databases/$(database)/documents/households/$(householdId);
    }

    // Membership is the ONLY way to reach household data. A user who merely
    // knows a householdId gets nothing.
    function isMember(householdId) {
      return isSignedIn()
        && exists(memberPath(householdId))
        && get(memberPath(householdId)).data.status == 'ACTIVE';
    }

    function memberRole(householdId) {
      return get(memberPath(householdId)).data.role;
    }

    // VIEWER can see everything in the household and change nothing.
    function canWrite(householdId) {
      return isMember(householdId)
        && memberRole(householdId) in ['OWNER', 'ADMIN', 'MEMBER', 'OPERATOR'];
    }

    function canAdminister(householdId) {
      return isMember(householdId)
        && memberRole(householdId) in ['OWNER', 'ADMIN'];
    }

    function isOwner(householdId) {
      return isMember(householdId) && memberRole(householdId) == 'OWNER';
    }

    // A document must declare the household it is stored under. This closes
    // the door on a client writing a document into household A that carries
    // household B's id and later being read back as if it belonged to B.
    function declaresHousehold(householdId) {
      return request.resource.data.householdId == householdId;
    }

    // Ownership and creation metadata are set once and never rewritten.
    function immutableAudit() {
      return request.resource.data.householdId == resource.data.householdId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    function isIntegerMoney(value) {
      return value is map
        && value.amount is int
        && value.currency is string;
    }

    // Financial documents are bounded in size. A runaway client cannot turn a
    // household document into a megabyte of notes.
    function reasonableSize() {
      return request.resource.data.keys().size() <= 60;
    }

    /**
     * O convite pendente endereçado a quem está chamando.
     *
     * O id do documento **é** o e-mail em minúsculas. Isso é o que permite a
     * regra encontrar o convite sem que o cliente diga qual é — se o id fosse
     * aleatório, o convidado teria de informá-lo, e informar um id não prova
     * nada sobre quem ele é.
     *
     * `get()` dentro de uma regra lê o documento independentemente das regras
     * de leitura, então o convidado não precisa ser membro para que a regra
     * verifique o convite dele.
     */
    function inviteFor(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)/invites/$(request.auth.token.email.lower()));
    }

    /**
     * Quem tem convite válido para este household.
     *
     * `email_verified` é inegociável: sem ele, bastaria alguém criar uma conta
     * com o e-mail de outra pessoa — sem nunca provar que o acessa — para
     * entrar no grupo dela. O Firebase só marca esse campo depois da
     * confirmação, e é o que separa "digitou um e-mail" de "é o dono dele".
     */
    function hasPendingInvite(householdId) {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/households/$(householdId)/invites/$(request.auth.token.email.lower()))
        && inviteFor(householdId).data.status == 'PENDING'
        && request.time < inviteFor(householdId).data.expiresAt;
    }

    function validNewDocument(householdId) {
      return declaresHousehold(householdId)
        && reasonableSize()
        && request.resource.data.createdBy == request.auth.uid;
    }

    /* ------------------------------------------------------------ */
    /* User profiles                                                 */
    /* ------------------------------------------------------------ */

    match /users/{uid} {
      allow get: if isSelf(uid);
      // Listing all users is never allowed, for anyone.
      allow list: if false;

      allow create: if isSelf(uid)
        && request.resource.data.uid == uid
        && request.resource.data.plan in ['FREE', 'PREMIUM'];

      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        // The plan is set by billing, never by the client. Until billing
        // exists, it can only stay as it is.
        && request.resource.data.plan == resource.data.plan;

      // Account deletion is a supported, explicit action (LGPD, docs/SECURITY.md).
      allow delete: if isSelf(uid);
    }

    /* ------------------------------------------------------------ */
    /* Assinaturas                                                   */
    /* ------------------------------------------------------------ */

    match /subscriptions/{uid} {
      // A pessoa lê a própria assinatura para a interface saber o que mostrar
      // e até quando vale. Listar todas nunca é permitido, para ninguém.
      allow get: if isSelf(uid);
      allow list: if false;

      // Escrita por ninguém, deliberadamente. Quem paga não pode declarar que
      // pagou. O servidor grava com o Admin SDK, que ignora estas regras —
      // é o único caminho privilegiado do projeto, e está inteiro sob
      // src/app/api/ e src/modules/billing/
      // (docs/adr/0009-server-side-payments.md).
      allow write: if false;
    }

    /* ------------------------------------------------------------ */
    /* Limite de requisições                                         */
    /* ------------------------------------------------------------ */

    match /rateLimits/{windowId} {
      // Nem leitura, nem escrita, para ninguém. Uma contagem que o navegador
      // pudesse ler diria quantas chamadas ainda cabem; uma que pudesse
      // escrever não seria um limite. Só o Admin SDK toca aqui, pelo mesmo
      // caminho privilegiado de `subscriptions`
      // (src/server/rate-limit-store.ts).
      allow read, write: if false;
    }

    /* ------------------------------------------------------------ */
    /* Registros de Dispositivos (Anti-Fraude e Anti-Burlar)         */
    /* ------------------------------------------------------------ */

    match /deviceRegistrations/{deviceHash} {
      // Escrita e leitura apenas pelo Admin SDK no servidor para controle
      // de cooldown e prevenção de criação de contas repetidas.
      allow read, write: if false;
    }

    /* ------------------------------------------------------------ */
    /* Households                                                    */
    /* ------------------------------------------------------------ */

    match /households/{householdId} {
      // Reading a household requires membership. The `list` case additionally
      // relies on the query being constrained to memberUids array-contains the
      // caller, which Firestore enforces against this same condition.
      // Quem tem convite válido lê o household antes de entrar.
      //
      // Não é conveniência: aceitar exige reenviar `memberUids` com o próprio
      // uid no fim, e ninguém consegue montar essa lista sem lê-la. Sem esta
      // linha o convite ficava impossível de aceitar — o convidado precisava
      // ser membro para se tornar membro.
      //
      // O que se expõe é o nome do grupo, o dono e a lista de uids, a quem já
      // recebeu um convite nominal, confirmado e dentro do prazo. A tela usa
      // isso para dizer em que casa a pessoa está entrando.
      allow get: if isMember(householdId) || hasPendingInvite(householdId);
      allow list: if isSignedIn() && request.auth.uid in resource.data.memberUids;

      // Bootstrap: whoever creates a household is its owner and its only
      // member. The matching members/{uid} document is written immediately
      // afterwards (see docs/SECURITY.md, "household bootstrap").
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid]
        && request.resource.data.createdBy == request.auth.uid
        && reasonableSize();

      // Duas formas de alterar o household:
      //
      //  - um administrador muda o que quiser, menos dono e data de criação;
      //  - um convidado se acrescenta a `memberUids`, e **nada mais**.
      //
      // A segunda existe para que aceitar um convite não dependa de servidor.
      // Ela é escrita como uma igualdade exata — a lista de antes com o uid de
      // quem chama no fim — porque qualquer folga aqui viraria a permissão de
      // reescrever a lista de membros do grupo.
      allow update: if (
          canAdminister(householdId)
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && reasonableSize()
        ) || (
          hasPendingInvite(householdId)
          && !(request.auth.uid in resource.data.memberUids)
          && request.resource.data.memberUids == resource.data.memberUids.concat([request.auth.uid])
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.name == resource.data.name
          && request.resource.data.settings == resource.data.settings
          && request.resource.data.archived == resource.data.archived
          && reasonableSize()
        );

      // Only the owner can delete the household.
      allow delete: if isOwner(householdId);

      /* ---------------------------------------------------------- */
      /* Membership                                                  */
      /* ---------------------------------------------------------- */

      match /members/{memberUid} {
        allow read: if isMember(householdId);

        // A profile with no access at all: a child, an elderly parent, anyone
        // who only needs to exist for "whose expense is this?".
        //
        // It grants nothing by *construction*, not by a check: `isMember`
        // reads members/$(request.auth.uid), so a document only ever confers
        // access when its id is the caller's own uid. The `dep_` prefix is
        // what makes that impossible here - Firebase Auth uids are 28
        // alphanumeric characters and never contain an underscore, so a
        // dependent id can never equal anyone's uid.
        //
        // Enforcing the prefix in the rule, and not only in the app, is the
        // point: without it an administrator could create members/{victimUid}
        // and make their household appear in a stranger's list.
        function isDependentProfile() {
          return memberUid.matches('^dep_[A-Za-z0-9]+$')
            && request.resource.data.role == 'DEPENDENT';
        }

        // Three ways a member document is created:
        //  - the founder claiming ownership of the household they just made;
        //  - an admin adding someone who is already listed in memberUids;
        //  - an admin adding a profile with no access.
        // The second case is what forces an admin to update the household
        // document first, keeping the array and the subcollection in step. The
        // third deliberately does *not* touch memberUids: a dependent has no
        // uid to put there, and putting one would be the bug.
        allow create: if isSignedIn()
          && request.resource.data.uid == memberUid
          && request.resource.data.householdId == householdId
          && (
            (
              memberUid == request.auth.uid
              && get(householdPath(householdId)).data.ownerUid == request.auth.uid
              && request.resource.data.role == 'OWNER'
            )
            || (
              canAdminister(householdId)
              && memberUid in get(householdPath(householdId)).data.memberUids
              && request.resource.data.role in ['ADMIN', 'MEMBER', 'VIEWER']
            )
            || (canAdminister(householdId) && isDependentProfile())
            // O convidado cria a própria participação, com o papel que o
            // convite fixou — nunca com um que ele escolha. Já precisa estar
            // em `memberUids`, o que só a regra acima permite, e só a quem
            // tem convite válido.
            || (
              memberUid == request.auth.uid
              && hasPendingInvite(householdId)
              && memberUid in get(householdPath(householdId)).data.memberUids
              && request.resource.data.role == inviteFor(householdId).data.role
              && request.resource.data.status == 'ACTIVE'
            )
          );

        // Admins manage roles, but nobody can promote themselves and the
        // owner's role cannot be changed by anyone else.
        //
        // A profile can never cross the line between having access and not
        // having it: a DEPENDENT stays DEPENDENT, and a real member never
        // becomes one. Both directions are refused because either would let an
        // administrator quietly change what a document means.
        allow update: if canAdminister(householdId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.householdId == householdId
          && resource.data.role != 'OWNER'
          && (resource.data.role == 'DEPENDENT') == (request.resource.data.role == 'DEPENDENT')
          && request.resource.data.role in ['ADMIN', 'MEMBER', 'OPERATOR', 'VIEWER', 'DEPENDENT']
          && !(memberUid == request.auth.uid && request.resource.data.role != resource.data.role);

        // Leaving is always your own right, owner included: without it, the
        // owner of a solo household could never delete their account, and the
        // LGPD right to erasure would exist only on paper.
        //
        // What must never happen is somebody *else* removing the owner, so the
        // admin branch excludes that case explicitly. The app additionally
        // refuses to leave a shared household without a responsible person
        // (see planAccountDeletion); this rule guarantees the part that
        // matters for security.
        allow delete: if isSelf(memberUid)
          || (canAdminister(householdId) && resource.data.role != 'OWNER');
      }

      /* ---------------------------------------------------------- */
      /* Invites                                                     */
      /* ---------------------------------------------------------- */

      match /invites/{inviteId} {
        // O convidado ainda não é membro e precisa ler o próprio convite para
        // a tela mostrar quem convidou e com que papel. Ler o convite de
        // outra pessoa continua fora.
        allow get: if isMember(householdId)
          || (isSignedIn() && request.auth.token.email != null
              && inviteId == request.auth.token.email.lower());
        allow list: if isMember(householdId);

        // O id é o e-mail em minúsculas, e a regra exige isso: um id
        // arbitrário quebraria a busca que `hasPendingInvite` faz, e um
        // convite que a regra não encontra é um convite que não funciona.
        allow create: if canAdminister(householdId)
          && validNewDocument(householdId)
          && inviteId == request.resource.data.email.lower()
          && request.resource.data.status == 'PENDING'
          && request.resource.data.role in ['ADMIN', 'MEMBER', 'OPERATOR', 'VIEWER'];

        // Quem convidou cancela; o convidado só pode marcar o próprio como
        // aceito, e uma vez só — depois disso ele não serve mais para entrar.
        allow update: if canAdminister(householdId)
          || (
            isSignedIn() && request.auth.token.email != null
            && inviteId == request.auth.token.email.lower()
            && resource.data.status == 'PENDING'
            && request.resource.data.status == 'ACCEPTED'
            && request.resource.data.email == resource.data.email
            && request.resource.data.role == resource.data.role
          );

        allow delete: if canAdminister(householdId);
      }

      /* ---------------------------------------------------------- */
      /* Financial data                                              */
      /*                                                             */
      /* Every collection below follows the same contract: members    */
      /* read, writers write, and a document can never change which   */
      /* household it belongs to.                                    */
      /* ---------------------------------------------------------- */

      match /categories/{categoryId} {
        allow read: if isMember(householdId);
        allow create: if canWrite(householdId) && validNewDocument(householdId);
        allow update: if canWrite(householdId) && immutableAudit() && reasonableSize();
        allow delete: if canWrite(householdId);
      }

      match /accounts/{accountId} {
        allow read: if isMember(householdId);
        allow create: if canWrite(householdId)
          && validNewDocument(householdId)
          && isIntegerMoney(request.resource.data.openingBalance);
        allow update: if canWrite(householdId)
          && immutableAudit()
          && reasonableSize()
          && isIntegerMoney(request.resource.data.openingBalance);
        // Deleting an account would orphan its movements; the app archives
        // instead. Only administrators may truly delete one.
        allow delete: if canAdminister(householdId);
      }

      match /transactions/{transactionId} {
        allow read: if isMember(householdId);
        allow create: if canWrite(householdId)
          && validNewDocument(householdId)
          && isIntegerMoney(request.resource.data.amount)
          && request.resource.data.amount.amount >= 0;
        allow update: if canWrite(householdId)
          && immutableAudit()
          && reasonableSize()
          && isIntegerMoney(request.resource.data.amount)
          && request.resource.data.amount.amount >= 0;
        allow delete: if canWrite(householdId);
      }

      match /obligations/{obligationId} {
        allow read: if isMember(householdId);
        allow create: if canWrite(householdId)
          && validNewDocument(householdId)
          && isIntegerMoney(request.resource.data.amount)
          && request.resource.data.amount.amount >= 0
          && request.resource.data.direction in ['INFLOW', 'OUTFLOW'];
        allow update: if canWrite(householdId)
          && immutableAudit()
          && reasonableSize()
          && isIntegerMoney(request.resource.data.amount);
        allow delete: if canWrite(householdId);
      }

      match /creditCards/{cardId} {
        allow read: if isMember(householdId);
        allow create: if canWrite(householdId)
          && validNewDocument(householdId)
          && isIntegerMoney(request.resource.data.creditLimit)
          && request.resource.data.closingDay is int
          && request.resource.data.closingDay >= 1
          && request.resource.data.closingDay <= 31
          && request.resource.data.dueDay is int
          && request.resource.data.dueDay >= 1
          && request.resource.data.dueDay <= 31;
        allow update: if canWrite(householdId) && immutableAudit() && reasonableSize();
        allow delete: if canAdminister(householdId);
      }

      match /cardPurchases/{purchaseId} {
        allow read: if isMember(householdId);
        allow create: if canWrite(householdId)
          && validNewDocument(householdId)
          && isIntegerMoney(request.resource.data.totalAmount)
          && request.resource.data.totalAmount.amount >= 0
          && request.resource.data.installmentCount is int
          && request.resource.data.installmentCount >= 1
          && request.resource.data.installmentCount <= 120;
        allow update: if canWrite(householdId) && immutableAudit() && reasonableSize();
        allow delete: if canWrite(householdId);
      }

      match /debts/{debtId} {
        allow read: if isMember(householdId);
        allow create: if canWrite(householdId)
          && validNewDocument(householdId)
          && isIntegerMoney(request.resource.data.principalContracted)
          && request.resource.data.installmentCount is int
          && request.resource.data.installmentCount >= 1
          && request.resource.data.installmentCount <= 600;
        allow update: if canWrite(householdId) && immutableAudit() && reasonableSize();
        allow delete: if canAdminister(householdId);
      }

      match /recurringRules/{ruleId} {
        allow read: if isMember(householdId);
        allow create: if canWrite(householdId)
          && validNewDocument(householdId)
          && isIntegerMoney(request.resource.data.amount);
        allow update: if canWrite(householdId) && immutableAudit() && reasonableSize();
        allow delete: if canWrite(householdId);
      }

      match /budgets/{budgetId} {
        allow read: if isMember(householdId);
        allow create: if canWrite(householdId) && validNewDocument(householdId);
        allow update: if canWrite(householdId) && immutableAudit() && reasonableSize();
        allow delete: if canWrite(householdId);
      }

      match /reserves/{reserveId} {
        allow read: if isMember(householdId);
        allow create: if canWrite(householdId)
          && validNewDocument(householdId)
          && isIntegerMoney(request.resource.data.currentAmount);
        allow update: if canWrite(householdId)
          && immutableAudit()
          && reasonableSize()
          && isIntegerMoney(request.resource.data.currentAmount);
        allow delete: if canWrite(householdId);
      }

      match /goals/{goalId} {
        allow read: if isMember(householdId);
        allow create: if canWrite(householdId)
          && validNewDocument(householdId)
          && isIntegerMoney(request.resource.data.targetAmount);
        allow update: if canWrite(householdId) && immutableAudit() && reasonableSize();
        allow delete: if canWrite(householdId);
      }

      // O histórico de decisões da família.
      //
      // Mesmo contrato das demais: membro lê, quem escreve escreve, e o
      // documento não muda de household. O valor é opcional aqui — nem toda
      // decisão tem um número ("adiar a troca da geladeira" não tem) — então
      // a checagem de dinheiro inteiro só se aplica quando o campo existe.
      match /decisions/{decisionId} {
        allow read: if isMember(householdId);
        allow create: if canWrite(householdId)
          && validNewDocument(householdId)
          && request.resource.data.status in ['PLANNED', 'DONE']
          && (!('amount' in request.resource.data.keys())
              || isIntegerMoney(request.resource.data.amount));
        allow update: if canWrite(householdId)
          && immutableAudit()
          && reasonableSize()
          && request.resource.data.status in ['PLANNED', 'DONE']
          && (!('amount' in request.resource.data.keys())
              || isIntegerMoney(request.resource.data.amount));
        allow delete: if canWrite(householdId);
      }

      match /vehicles/{vehicleId} {
        allow read: if isMember(householdId);
        allow create: if canWrite(householdId) && validNewDocument(householdId);
        allow update: if canWrite(householdId) && immutableAudit() && reasonableSize();
        allow delete: if canWrite(householdId);
      }

      // No catch-all is written here on purpose. In Firestore, rules are
      // combined with OR: an `allow ... if false` cannot take away a grant, it
      // can only look reassuring. Any sub-collection not named above is
      // already denied because nothing grants it. A new feature must add its
      // own match block, and its tests (tests/rules).
    }

    /* ------------------------------------------------------------ */
    /* Everything else                                               */
    /*                                                               */
    /* Firestore denies by default; this block exists so the intent  */
    /* is stated explicitly in the file rather than assumed.         */
    /* ------------------------------------------------------------ */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
