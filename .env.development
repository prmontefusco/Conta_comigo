# Local development defaults - safe to commit.
#
# Points exclusively at the `demo-` Firebase project and the local Emulator
# Suite. A `demo-*` project id makes the emulators refuse to contact any real
# Google Cloud resource, so these values cannot leak or bill anything.
#
# Used when running `npm run dev` directly. When running through
# `npm run dev:local`, apphosting.emulator.yaml supplies the same values.

NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-conta-comigo
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-conta-comigo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demolocal
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

NEXT_PUBLIC_ADS_ENABLED=false
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Preços em centavos inteiros. Não são segredo: aparecem na tela de planos.
# Ficam aqui para que a tela funcione em desenvolvimento; sem chave do provedor
# a venda continua fechada, que é o comportamento correto numa máquina local.
SUBSCRIPTION_PRICE_MONTHLY_CENTS=799
SUBSCRIPTION_PRICE_YEARLY_CENTS=6999
