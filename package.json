{
  "name": "conta-comigo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "dev:next": "next dev --turbopack",
    "dev:local": "concurrently -n emulators,seed -c blue,green \"npm:emulators:all\" \"npm:seed:when-ready\"",
    "emulators": "firebase emulators:start --project demo-conta-comigo --only auth,firestore",
    "emulators:all": "firebase emulators:start --project demo-conta-comigo",
    "emulators:export": "firebase emulators:export ./firebase-export-data --project demo-conta-comigo --force",
    "seed": "tsx scripts/seed.ts",
    "seed:when-ready": "wait-on -t 240000 tcp:127.0.0.1:8080 tcp:127.0.0.1:9099 && npm run seed",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --project demo-conta-comigo --only firestore \"vitest run --config vitest.rules.config.mts\"",
    "test:rules:attached": "vitest run --config vitest.rules.config.mts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:rules",
    "postinstall": "node scripts/check-node-version.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "firebase": "^12.18.0",
    "next": "15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.86.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.4",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.28.2",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "@opentelemetry/core": "^2.8.0",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "description": "Plataforma de planejamento financeiro pessoal e familiar"
}
